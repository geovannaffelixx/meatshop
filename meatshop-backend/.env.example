# ===================================
# DB — Postgres local (via docker compose up -d db)
# ===================================
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=meatshop_user
DB_PASSWORD=meatshop_pass
DB_DATABASE=meatshop
# true só em desenvolvimento local — nunca em produção (ver src/app.module.ts)
DB_SYNCHRONIZE=true
DB_SSL=false

# SQLite fallback (usado apenas se DB_TYPE não estiver definido como postgres)
DB_PATH=./data/meatshop.db

# ===================================
# Auth — gere valores próprios, nunca reutilize os deste arquivo
# ===================================
# Ex.: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
DELIVERY_CODE_SECRET=
DELIVERY_CODE_ENCRYPTION_KEY=
PICKUP_CODE_TTL_MINUTES=240
DELIVERY_CODE_TTL_HOURS=72
DEFAULT_DELIVERY_FEE=8.50
DELIVERY_FEE_BASE=3.20
DELIVERY_FEE_PER_KM=1.10
DELIVERY_FEE_LONG_DISTANCE_KM=8
DELIVERY_FEE_LONG_DISTANCE_SURCHARGE=2
DELIVERY_FEE_PEAK_MULTIPLIER=1.3
BRASIL_API_BASE_URL=https://brasilapi.com.br/api

# ===================================
# CORS / Cookies
# ===================================
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# ===================================
# App
# ===================================
PORT=3001
NODE_ENV=development
TZ=America/Sao_Paulo

# ===================================
# E-mail (Mailtrap sandbox em dev, provedor real em produção)
# ===================================
MAIL_HOST=
MAIL_PORT=2525
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# ===================================
# Mercado Pago
# ===================================
MP_ACCESS_TOKEN=
# Obrigatório: sem isso o webhook de pagamento rejeita toda notificação (ver mercadopago.webhook.controller.ts)
MP_WEBHOOK_SECRET=
MP_WEBHOOK_TOLERANCE_SECONDS=300
BACKEND_PUBLIC_URL=http://localhost:3001
BACKEND_WEBHOOK_PATH=/webhooks/mercadopago
MP_ENV=sandbox

# ===================================
# Firebase (push notifications via FCM)
# ===================================
# JSON completo da service account (Firebase Console > Project Settings > Service Accounts > Generate new private key).
# Sem essa variável, o envio de push fica indisponível (503) mas o restante do módulo de notificações funciona normalmente.
FIREBASE_SERVICE_ACCOUNT=
