# ===============================
# URL base da API do backend NestJS
# ===============================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origem do backend para o proxy /api do próprio painel. Quando definida, use
# NEXT_PUBLIC_API_URL=<url do painel>/api para manter os cookies de sessão no mesmo site.
API_PROXY_TARGET=

# Style JSON opcional de um provedor compatível com MapLibre.
# Quando vazio, o painel usa tiles raster do OpenStreetMap, sem token.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
