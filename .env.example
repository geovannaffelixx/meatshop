# Variáveis lidas pelo docker-compose.yml da raiz.
# Gere o .env local (ignorado pelo Git) com valores aleatórios de desenvolvimento:
#   node scripts/setup-local-env.mjs
# O script preserva valores já existentes no .env e só preenche os segredos vazios.
# Nunca reutilize os valores locais em homologação ou produção.

# Senha do PostgreSQL local do Compose (usuário meatshop_user, porta 5433).
# Valor exclusivo de desenvolvimento, esperado também pelos testes e2e locais.
POSTGRES_PASSWORD=meatshop_pass

# Segredos de assinatura dos JWT de acesso e refresh (mínimo 32 caracteres; gerados pelo script).
JWT_SECRET=
JWT_REFRESH_SECRET=

# Segredo HMAC e chave de criptografia dos códigos de entrega/retirada (mínimo 32 caracteres; gerados pelo script).
DELIVERY_CODE_SECRET=
DELIVERY_CODE_ENCRYPTION_KEY=

# Chave AES-256-GCM dos dados pessoais criptografados em repouso (CPF, telefone, contato de chamados).
# Base64 de 32 bytes aleatórios. Gere com: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Chave HMAC-SHA256 dos índices cegos (cpf_hash, phone_hash) usados em unicidade e busca.
# Base64 de 32 bytes aleatórios, diferente de DATA_ENCRYPTION_KEY. Gere com: openssl rand -base64 32
DATA_HASH_KEY=

# Token Bearer exigido em /metrics; o Prometheus do Compose o recebe como secret de arquivo.
# Gere com: openssl rand -hex 32
METRICS_TOKEN=

# Token Bearer que o Alertmanager envia para /monitoring/alerts do backend.
# Gere com: openssl rand -hex 32
MONITORING_WEBHOOK_TOKEN=

# Chave interna compartilhada entre backend (AI_CHATBOT_SERVICE_KEY) e chatbot (SERVICE_API_KEY).
# Gere com: openssl rand -hex 32
AI_CHATBOT_SERVICE_KEY=

# Chave da API Groq usada pelo chatbot. Opcional: sem ela o chatbot sobe, mas não gera respostas.
GROQ_API_KEY=

# Minutos para o estabelecimento confirmar pedidos com pagamento offline antes do cancelamento automático.
ORDER_CONFIRMATION_TIMEOUT_MINUTES=30

# Senha dos usuários criados pelo seed de desenvolvimento (scripts/reset-development.ps1; gerada pelo script).
SEED_PASSWORD=

# Senha do usuário admin do Grafana (perfil observability; gerada pelo script).
GRAFANA_ADMIN_PASSWORD=

# URLs públicas do ambiente local.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Firebase. FIREBASE_SERVICE_ACCOUNT é o JSON da conta de serviço em uma linha
# (prefira scripts/start-local-with-firebase.ps1, que injeta o valor só no processo).
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_WEB_API_KEY=

# Mercado Pago (opcional no ambiente local). Veja .env.payments.example e docs/PAYMENTS_SETUP.md.
PAYMENTS_ENABLED=false
MP_ENV=sandbox
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=
MP_CREDENTIAL_ENCRYPTION_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PAYMENTS_LEGACY_TIMEZONE=America/Sao_Paulo

# Escala horizontal (docker-compose.scale.yml) e retenção de tentativas de autenticação.
SOCKET_IO_SHARED=false
BACKEND_REPLICAS=1
AUTH_ATTEMPTS_RETENTION_DAYS=30
